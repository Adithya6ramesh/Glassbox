{
  "name": "@glassbox-ai/engine",
  "version": "0.1.3",
  "description": "Glassbox security engine: pure, deterministic analysis of MCP metadata and agent tool calls.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "security",
    "prompt-injection",
    "tool-poisoning",
    "claude-code"
  ],
  "homepage": "https://github.com/Adithya6ramesh/Glassbox#readme",
  "bugs": {
    "url": "https://github.com/Adithya6ramesh/Glassbox/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adithya6ramesh/Glassbox.git",
    "directory": "packages/engine"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ruleset": {
      "types": "./dist/ruleset-entry.d.ts",
      "import": "./dist/ruleset-entry.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "prepublishOnly": "tsc -b"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "re2js": "2.9.1",
    "valibot": "1.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
